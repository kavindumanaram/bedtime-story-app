{
  "name": "bedtime-story-root",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@prisma/client", "@prisma/engines", "prisma"]
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @bedtime/backend dev\" \"pnpm --filter @bedtime/frontend dev\"",
    "build": "pnpm --filter @bedtime/frontend build",
    "test": "pnpm --filter @bedtime/frontend test",
    "test:run": "pnpm --filter @bedtime/frontend test:run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
